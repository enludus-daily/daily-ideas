#!/usr/bin/env bash
# push の前に秘密情報・個人情報を検査する（scripts/scan-sensitive.sh は daily-actions/scan/ の複製）。有効にする: git config core.hooksPath .githooks
set -euo pipefail
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
ran=0
while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "$zero" ] && continue
  if [ "$rsha" = "$zero" ]; then range="$lsha"; else range="$rsha..$lsha"; fi
  bash "$root/scripts/scan-sensitive.sh" "$root" "$range"
  ran=1
done
[ "$ran" -eq 1 ] || bash "$root/scripts/scan-sensitive.sh" "$root" ""
